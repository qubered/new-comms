{
  "name": "new-comms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && cargo test --workspace",
    "seed": "tsx scripts/seed-v2.ts",
    "show": "node scripts/dev.mjs --show",
    "node": "cargo run --release -p comms-node --",
    "smoke": "cargo build --release -p mix-router && ./target/release/smoke && ./target/release/smoke_v2",
    "mixer": "cargo run --release -p mix-router --"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
